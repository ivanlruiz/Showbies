# Copiar a ShowBies1/keystore.local (gitignoreado) y completar. Lo lee
# Build > Android AAB (release). Formato clave=valor, sin comillas.
# El keystore va FUERA del repo, con ruta absoluta (una relativa sale de ShowBies1).
# Adentro del clon, aunque *.keystore este gitignoreado, lo borran un git clean -xdf o
# volver a clonar. Y con una copia fuera de la computadora (ver publicacion/pasos.md).
keystore=C:/Users/<usuario>/claves/showbies-release.keystore
alias=showbies
storepass=
keypass=
